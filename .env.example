# Your Octen API key (claim USD 25 in event credits on the event page; its address is on the big screen)
OCTEN_API_KEY=

# Game server URL: the event page's address (copy the line from the event page)
SCOOP_SERVER=

# Your team's token (copy the line from the event page; everyone on the team uses the same one)
SCOOP_TOKEN=

# Optional: which CLI answers the clues (claude | codex), and Claude's model and effort (low | medium | high)
# SCOOP_AGENT=claude
# SCOOP_CLAUDE_MODEL=sonnet
# SCOOP_CLAUDE_EFFORT=low

# Optional, with SCOOP_AGENT=codex: Codex model and reasoning effort for the agent (low | medium | high; the default model has no "minimal")
# CODEX_MODEL=
# CODEX_REASONING=low
